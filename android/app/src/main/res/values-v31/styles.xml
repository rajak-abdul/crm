<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ launch theme (Dark Mode off). The system splash only
         takes a solid colour and an icon: use the splash video's colour and
         no icon, so it blends straight into the video. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/splash_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon_transparent</item>
    </style>
</resources>
